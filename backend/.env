PORT=5000
MONGO_URI=mongodb+srv://harsh074singhal_db_user:BorrowNest123@borrownest-cluster.kfcadgc.mongodb.net/borrownest
JWT_SECRET=borrownest_super_secret_key

# ──────────────────────────────────────────────────────
# FRONTEND URL (used for password reset links)
# Change this to your deployed frontend URL in production
# ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080

# ──────────────────────────────────────────────────────
# CORS (allowed frontend origins, comma-separated)
# In production, set this to your deployed frontend URL.
# Example: CORS_ORIGIN=https://borrownest.vercel.app
# ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8080

# ──────────────────────────────────────────────────────
# RAZORPAY (Payment Gateway)
# Get test-mode keys from: https://dashboard.razorpay.com
#   1. Sign up / Log in to Razorpay Dashboard
#   2. Go to Settings → API Keys → Generate Test Key
#   3. Copy Key ID (starts with rzp_test_) and Key Secret
# Replace the placeholders below with your actual test keys.
# While placeholders are set, "Pay Online" will show a
# friendly error asking the user to configure keys.
# ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# ──────────────────────────────────────────────────────
# EMAIL (Nodemailer — for Forgot Password)
# Uses Gmail SMTP. To set up:
#   1. Use a dedicated project email (e.g. borrownestofficial@gmail.com)
#   2. Enable 2-Step Verification on that Google account
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Generate an App Password for "Mail"
#   5. Set EMAIL_USER to the Gmail address
#   6. Set EMAIL_PASS to the 16-char App Password (no spaces)
#
# If these are left blank/commented, the server automatically
# uses Ethereal (a fake SMTP service) and logs a preview URL
# to the console so you can test without a real email account.
# ──────────────────────────────────────────────────────
# EMAIL_USER=borrownestofficial@gmail.com
# EMAIL_PASS=your_16_char_app_password
EMAIL_USER=borrownestofficial@gmail.com
EMAIL_PASS=icmmjmamfnkeewes
